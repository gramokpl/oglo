APP_NAME="Serwis Ogłoszeniowy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Warsaw
APP_URL=http://localhost:8000
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en

# Baza danych (Domyślnie SQLite lub MySQL)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ogloszenia_db
# DB_USERNAME=root
# DB_PASSWORD=

# Sesje, cache i kolejki
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Integracja Stripe Checkout & Webhooks
STRIPE_KEY=pk_test_twoj_klucz_publiczny
STRIPE_SECRET=sk_test_twoj_klucz_prywatny
STRIPE_WEBHOOK_SECRET=whsec_twoj_webhook_secret
STRIPE_CURRENCY=pln

# AI Studio & API Services
GEMINI_API_KEY=
